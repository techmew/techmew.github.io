{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "otodama-room",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      },
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Matchmaker"
      ]
    }
  ]
}
